{
  "name": "vibe-to-ship",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-keywords.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:keywords": "node scripts/check-keywords.mjs",
    "plan:page": "node scripts/topic-map-page.mjs",
    "status": "node scripts/site-status.mjs",
    "check:links": "node scripts/check-links.mjs",
    "seo:today": "node scripts/seo-today.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:push": "node scripts/seo-push.mjs",
    "seo:auto": "node scripts/seo-auto/run-daily.mjs",
    "seo:auto:today": "node scripts/seo-auto/today.mjs",
    "seo:auto:check": "node scripts/seo-auto/check.mjs",
    "seo:auto:push": "node scripts/seo-auto/push.mjs",
    "seo:daily": "node scripts/seo/daily.mjs",
    "seo:collect": "node scripts/seo/collect-crawl.mjs && node scripts/seo/collect-tongji.mjs && node scripts/seo/collect-bing.mjs && node scripts/seo/collect-baidu-console.mjs",
    "seo:analyze": "node scripts/seo/analyze.mjs && node scripts/seo/report.mjs",
    "seo:rank": "node scripts/seo/collect-rank.mjs",
    "seo:geo": "node scripts/seo/collect-geo.mjs --force",
    "seo:tongji-auth": "node scripts/seo/tongji-auth.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
