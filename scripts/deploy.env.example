# 复制为 scripts/deploy.env（已在 .gitignore 里，不会提交）
DEPLOY_HOST=root@你的服务器IP
DEPLOY_KEY=~/.ssh/你的私钥文件
# 下面两项用宝塔默认布局时可以不填
# DEPLOY_ROOT=/www/wwwroot/eryx.cn
# DEPLOY_NGINX_EXT=/www/server/panel/vhost/nginx/extension/eryx.cn/vibe-to-ship.conf
# 百度搜索资源平台 → 普通收录 → API 提交 里的 token；填了以后每次部署自动推送新网址
# BAIDU_PUSH_TOKEN=

# ── 自动 SEO 流水线（npm run seo:daily，每天 7:30 由 launchd cn.eryx.seo-daily 跑）──
# 服务器 nginx 访问日志路径（宝塔默认就是这个，可不填）
# NGINX_LOG=/www/wwwlogs/eryx.cn.log
# 百度统计 → 管理 → 数据导出服务：开通后拿 API Key / Secret Key，再跑一次 npm run seo:tongji-auth 授权
# BAIDU_TONGJI_API_KEY=
# BAIDU_TONGJI_SECRET=
# Bing Webmaster Tools → 设置 → API 访问 → 生成 API Key
# BING_API_KEY=
# GEO 探测用的 AI 接口（有哪家填哪家，每周一问一遍）
# KIMI_API_KEY=
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=
# DOUBAO_MODEL=        火山方舟的接入点 id，豆包必填
# PERPLEXITY_API_KEY=
