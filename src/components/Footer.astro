---
import { SITE } from '../data/site';
---

<footer>
  <div class="wrap">
    <div>
      © {new Date().getFullYear()} {SITE.name} · {new URL(SITE.url).host}<br />备案号：{SITE.icp}<br />
      文章采用 CC BY-NC-SA 4.0 许可，网站代码采用 MIT 许可
    </div>
    <div class="links">
      <a href="/articles/">全部文章</a>
      <a href="#" title="待补充">隐私政策（待补）</a>
      <a href="#" title="待补充">联系邮箱（待填）</a>
      {SITE.github ? <a href={SITE.github}>GitHub</a> : <span>GitHub（即将公开）</span>}
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>

<style>
  footer{border-top:1px solid var(--line);padding:32px 0 48px;color:var(--muted);font-size:13.5px}
  footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
  .links{display:flex;gap:18px;flex-wrap:wrap}
  .links a:hover{color:var(--ink)}
</style>
