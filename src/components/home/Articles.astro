---
import CategoryGrid from '../CategoryGrid.astro';
import ArticleList from '../ArticleList.astro';
import { WHAT_IS } from '../../data/site';
import type { Article } from '../../lib/articles';

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---

<section id="articles">
  <div class="wrap">
    <div class="sec-head">
      <div><h2>你要上线什么？</h2><p>按产品形态看完整流程，每篇开头 150 字直接给结论</p></div>
      <a class="more" href="/articles/">全部文章 →</a>
    </div>
    <CategoryGrid articles={articles} kind="platform" />

    <div class="two">
      <div>
        <h3 class="col-title">最新文章</h3>
        <ArticleList articles={articles.slice(0, 5)} />
      </div>
      <div>
        <h3 class="col-title">从哪开始？</h3>
        <div class="starts">
          <a class="start" href={WHAT_IS.path}><h4>还在想要不要做</h4><p>先看什么是 AI 独立开发者、适不适合你。</p></a>
          <a class="start" href="/flow/idea/"><h4>已经有想法了</h4><p>从第 1 步「想清楚做什么」开始，第一版先砍掉一半功能。</p></a>
          <a class="start" href="/flow/deploy/"><h4>做出来了，放不上网</h4><p>直接看第 5 步「服务器和部署」，全程交给 AI。</p></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .two{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:28px;margin-top:36px}
  .col-title{font-size:18px;margin-bottom:12px}
  .starts{display:flex;flex-direction:column;gap:12px}
  .start{background:var(--soft);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;transition:.15s}
  .start:hover{border-color:var(--accent)}
  .start h4{font-size:15px}
  .start p{font-size:13.5px;color:var(--muted);margin-top:2px}
  @media (max-width:900px){
    .two{grid-template-columns:minmax(0,1fr)}
  }
</style>
