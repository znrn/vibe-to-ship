---
import { SITE, WHAT_IS } from '../../data/site';

const chips = ['ICP 备案被驳回', 'SSH 密钥配置', '域名解析不生效', 'HTTPS 小锁不亮', '小程序审核被拒', '没执照怎么收钱'];
---

<header class="hero">
  <div class="wrap">
    <span class="eyebrow">AI 独立开发 · 不教写代码，只管把东西推上线</span>
    <h1>不会写代码，<em>也能靠 AI</em><br />一个人把产品做到上线并收到钱</h1>
    <p class="sub">写代码已经交给 AI，难的是想清楚做什么、放上网、收到钱。这里按 9 步拆开每一步：你来决定什么、交给 AI 做什么、哪些事只能你亲自做。</p>
    <form class="search" action="/articles/" method="get" role="search">
      <span aria-hidden="true">🔍</span>
      <input name="q" placeholder="你卡在哪一步了？比如：备案被驳回" aria-label="搜索问题" />
      <button class="btn primary" type="submit">找答案</button>
    </form>
    <div class="chips">
      {chips.map((c) => <a class="chip" href={`/articles/?q=${encodeURIComponent(c)}`}>{c}</a>)}
    </div>
    <div class="hero-ctas">
      <a class="btn primary" href="/flow/">从第 1 步开始 →</a>
      <a class="btn" href={WHAT_IS.path}>什么是 AI 独立开发者？</a>
      {SITE.github ? <a class="btn" href={SITE.github}>⭐ GitHub 开源手册</a> : <span class="btn placeholder">⭐ GitHub 开源手册（即将公开）</span>}
    </div>
  </div>
</header>

<style>
  .hero{padding:72px 0 56px;text-align:center}
  .hero h1{font-size:clamp(30px,5.2vw,50px);line-height:1.25;letter-spacing:-.5px;font-weight:800}
  .hero h1 em{font-style:normal;color:var(--accent)}
  .sub{max-width:620px;margin:18px auto 30px;color:var(--muted);font-size:17px}
  .search{max-width:600px;margin:0 auto;display:flex;align-items:center;gap:10px;background:var(--surface);border:1.5px solid var(--line);border-radius:999px;padding:6px 6px 6px 20px;box-shadow:0 6px 24px rgb(0 0 0 / .05)}
  .search:focus-within{border-color:var(--accent)}
  .search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font:inherit;color:var(--ink)}
  .chips{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin:18px auto 0;max-width:720px}
  .chip{font-size:13px;padding:5px 12px;border-radius:999px;background:var(--soft);color:var(--muted);border:1px solid var(--line)}
  .chip:hover{color:var(--accent);border-color:var(--accent)}
  .hero-ctas{display:flex;gap:12px;justify-content:center;margin-top:30px;flex-wrap:wrap}
  @media (max-width:560px){
    .hero{padding:44px 0 36px}
    .search{padding-left:16px}
    .search .btn{padding:9px 14px}
  }
</style>
