---
// 分工标签：🧑 你来做 / 🤖 交给 AI / ✅ 你来验收（样式在 global.css，正文里也能直接写 <span class="role-tag me">）
interface Props {
  who: 'me' | 'ai' | 'check';
}
const LABEL = { me: '🧑 你来做', ai: '🤖 交给 AI', check: '✅ 你来验收' } as const;
const { who } = Astro.props;
---

<span class:list={['role-tag', who]}>{LABEL[who]}</span>
