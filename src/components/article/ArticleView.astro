---
// 文章页的完整布局：问题页（/articles/<id>/），以及还没有静态支柱页的流程页（/flow/<步骤>/）兜底。
// 版式与支柱页一致（PillarLayout 三栏）：
//   顶部结论卡（先说结论 + 照做步骤 + 所属步骤/形态/日期）→ 正文 → 人和 AI 的分工 → FAQ → 来源 → 文末出口。
//   左侧栏是 9 步流程（高亮本文所在的一步）+ 这一步的其他问题页；右侧是本页目录。
import { getEntry, render } from 'astro:content';
import PillarLayout from '../../layouts/PillarLayout.astro';
import ArticleExit from './ArticleExit.astro';
import ArticleFaq from './ArticleFaq.astro';
import ArticleSources from './ArticleSources.astro';
import ArticleWorkflow from './ArticleWorkflow.astro';
import AiRunCard from './AiRunCard.astro';
import RoleTag from './RoleTag.astro';
import ArticleList from '../ArticleList.astro';
import { SITE, ROADMAP, platformOf, topicOf } from '../../data/site';
import { flowUrl } from '../../data/flow';
import { getArticles, articleUrl, formatDate, stageOfArticle, type Article } from '../../lib/articles';
import { markdownUrl } from '../../lib/markdown';

interface Props {
  article: Article;
  // 流程页才传：这一步下面的问题页
  questions?: Article[];
}
const { article, questions = [] } = Astro.props;
const { data } = article;
const isFlow = data.kind === 'flow';
const { Content, headings } = await render(article);
const next = data.next ? await getEntry(data.next) : undefined;
const related = (await Promise.all(data.related.map((r) => getEntry(r)))).filter((a): a is Article => !!a && !a.data.draft);
const step = stageOfArticle(article);
const url = new URL(articleUrl(article), Astro.site).href;
const mdUrl = new URL(markdownUrl(article), Astro.site).href;
const left = ROADMAP.length - step.step;
// 同一步的其他问题页，放在左侧栏
const siblings = (await getArticles()).filter((a) => a.data.stage === data.stage && a.data.kind !== 'flow' && a.id !== article.id);
// 排障表里链到的问题页
const troubleshoot = await Promise.all(
  data.troubleshoot.map(async (t) => {
    const linked = t.link ? await getEntry(t.link) : undefined;
    return { ...t, href: linked && !linked.data.draft ? articleUrl(linked) : undefined };
  }),
);
const hasWorkflow =
  (data.handoff && (data.handoff.prepare.length > 0 || data.handoff.prompts.length > 0)) ||
  data.humanOnly.length > 0 ||
  data.verify.length > 0 ||
  troubleshoot.length > 0 ||
  data.boundaries.length > 0;
const workflowId = data.handoff && (data.handoff.prepare.length > 0 || data.handoff.prompts.length > 0)
  ? 'handoff'
  : data.humanOnly.length > 0
    ? 'human-only'
    : data.verify.length > 0
      ? 'verify'
      : troubleshoot.length > 0
        ? 'troubleshoot'
        : 'boundaries';

const crumbs = isFlow
  ? [
      { name: '首页', href: '/' },
      { name: '上线流程', href: '/flow/' },
      { name: `第 ${step.step} 步 · ${step.name}`, href: flowUrl(step.slug) },
    ]
  : [
      { name: '首页', href: '/' },
      { name: `第 ${step.step} 步 · ${step.name}`, href: flowUrl(step.slug) },
      { name: data.title, href: articleUrl(article) },
    ];

// 右侧目录：结论 → 正文二级标题 → 分工 → FAQ → 来源
const h2s = headings.filter((h) => h.depth === 2);
const toc = [
  { id: 'sec-header-conclusion', label: '先说结论', kind: 'conclusion' as const },
  ...h2s.map((h, i) => ({ id: h.slug, label: h.text, num: String(i + 1).padStart(2, '0') })),
  ...(hasWorkflow ? [{ id: workflowId, label: '人和 AI 的分工', kind: 'warn' as const }] : []),
  ...(isFlow ? [{ id: 'questions', label: '这一步常见的问题' }] : []),
  ...(data.faq.length > 0 ? [{ id: 'faq', label: '常见问题 FAQ', kind: 'faq' as const }] : []),
  ...(data.sources.length > 0 ? [{ id: 'sources', label: '参考来源' }] : []),
];

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    inLanguage: 'zh-CN',
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    ...(data.sources.length > 0 && {
      citation: data.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
    }),
    articleSection: step.name,
    keywords: [data.keyword, ...data.covers].join(','),
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
    author: { '@type': 'Person', name: SITE.author.name, url: SITE.url, description: SITE.author.description },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })),
  },
];
if (data.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<PillarLayout slug={data.stage} mode={isFlow ? 'flow' : 'article'} title={data.title} description={data.description} toc={toc} crumbs={crumbs} jsonLd={jsonLd} showQuestions={false}>
  <Fragment slot="head">
    <meta property="article:published_time" content={data.date.toISOString()} />
    <meta property="article:author" content={SITE.author.name} />
    <link rel="alternate" type="text/markdown" href={markdownUrl(article)} title="纯文本版（给 AI 读）" />
  </Fragment>

  <Fragment slot="sidebar">
    <p class="sb-note">
      {isFlow ? <>这是第 {step.step} 步的完整流程。</> : <>这篇在<b>第 {step.step} 步</b>，解决「{data.keyword}」。</>}
      {left > 0 ? <>走完这一步，后面还有 <b>{left} 步</b>。</> : <>这是最后一步，但前面每一步都得走通。</>}
    </p>
    {siblings.length > 0 && (
      <div class="sb-related">
        <div class="sb-phase-title">这一步的其他问题</div>
        {siblings.slice(0, 8).map((a) => <a href={articleUrl(a)}>{a.data.title}</a>)}
      </div>
    )}
  </Fragment>

  <header class="header-card" id="sec-header-conclusion">
    <div class="header-meta-row">
      <div class="header-pill-group">
        <span class="phase-pill-dark">{isFlow ? `第 ${step.step} 步 · 完整流程` : `问题页 · 第 ${step.step} 步`}</span>
        <span class="step-pill-emerald">{step.icon} {step.name}</span>
        {data.sample && <span class="sample-tag">示例文章</span>}
      </div>
      <div class="header-status-indicator">
        <span class="status-dot-pulse"></span>
        <span>
          作者 {SITE.author.name} · <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          {data.updated && <> · 更新于 <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></>}
        </span>
      </div>
    </div>

    <h1 class="header-main-h1">{data.title}</h1>

    <div class="header-conclusion-inner">
      <div class="hci-badge-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
        <span>先说结论</span>
      </div>
      <p class="hci-text">{data.answer}</p>
      {data.steps.length > 0 && (
        <ol class="hci-steps">
          {data.steps.map((s) => (typeof s === 'string' ? <li>{s}</li> : <li><RoleTag who={s.who} /> {s.text}</li>))}
        </ol>
      )}
    </div>

    <div class="header-meta-grid">
      <div class="meta-tag-card">
        <div class="meta-tag-icon-box">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
        </div>
        <div class="meta-tag-content">
          <span class="meta-tag-label">所属步骤:</span>
          <span><a href={flowUrl(step.slug)}>第 {step.step} 步 · {step.name}</a></span>
        </div>
      </div>
      <div class="meta-tag-card">
        <div class="meta-tag-icon-box">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M2 10h20"></path></svg>
        </div>
        <div class="meta-tag-content">
          <span class="meta-tag-label">适用形态:</span>
          <span>
            {data.platforms.map((p) => <a class="meta-chip" href={`/platforms/${p}/`}>{platformOf(p).name}</a>)}
            {data.topics.map((t) => <a class="meta-chip" href={`/topics/${t}/`}>#{topicOf(t).name}</a>)}
          </span>
        </div>
      </div>
      <div class="meta-tag-card">
        <div class="meta-tag-icon-box">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
        </div>
        <div class="meta-tag-content">
          <span class="meta-tag-label">{data.reviewed ? '内容核对:' : '文章主词:'}</span>
          <span>{data.reviewed ? `已对照来源核实 · ${formatDate(data.reviewed)}` : data.keyword}</span>
        </div>
      </div>
    </div>
  </header>

  <article class="main-article-card">
    {!isFlow && (
      <a class="in-flow" href={flowUrl(step.slug)}>
        这篇属于上线流程第 {step.step} 步「{step.name}」<b>看这一步的完整流程 →</b>
      </a>
    )}

    <div class="prose">
      <Content />
    </div>

    <ArticleWorkflow handoff={data.handoff} humanOnly={data.humanOnly} verify={data.verify} troubleshoot={troubleshoot} boundaries={data.boundaries} />

    {isFlow && (
      <section class="flow-questions" id="questions">
        <h2>这一步常见的问题</h2>
        {questions.length > 0 ? <ArticleList articles={questions} showDesc /> : <p class="empty">这一步的问题页还在写。</p>}
      </section>
    )}

    <ArticleFaq items={data.faq} />

    {data.aiRun && <AiRunCard url={mdUrl} task={data.keyword} />}

    <ArticleSources sources={data.sources} reviewed={data.reviewed} />

    {related.length > 0 && (
      <section class="related" id="related">
        <h2>相关问题</h2>
        <ArticleList articles={related} />
      </section>
    )}

    <ArticleExit step={step.step} stuckNext={data.stuckNext} next={next} />
  </article>
</PillarLayout>

<style>
  .related { margin-top: 36px; }
  .related h2 { font-size: 20px; margin-bottom: 12px; }
  .flow-questions { margin-top: 40px; }
  .flow-questions h2 { font-size: 20px; margin-bottom: 12px; }
  .flow-questions .empty { border: 1px dashed var(--line); border-radius: 12px; padding: 14px 18px; color: var(--muted); font-size: 14px; }
</style>
