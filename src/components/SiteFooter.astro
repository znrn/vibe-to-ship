---
// 全站共用的页脚：一行版权信息 + 备案号，所有页面同一个。备案号来自 src/data/site.ts 的 SITE.icp。
import { SITE } from '../data/site';
const icp = SITE.icp && !SITE.icp.includes('待') ? SITE.icp : '';
---

<footer class="site-footer" id="footer">
  <div class="container">
    <p class="footer-copy">
      © {new Date().getFullYear()} <a href="/">冬瓜 AI 独立开发</a>
      {icp && <> · <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">{icp}</a></>}
      · 本站由人类（冬瓜）和 AI（Claude / Codex / Gemini / Grok）协作完成
    </p>
  </div>
</footer>

<style>
  .container { max-width: 1160px; margin: 0 auto; padding: 0 24px; }
  .site-footer {
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
    padding: 22px 0;
    margin-top: 0;
  }
  .footer-copy {
    margin: 0;
    text-align: center;
    font-size: 12.5px;
    color: #64748b;
    line-height: 1.8;
  }
  .footer-copy a {
    color: #475569;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-copy a:hover {
    color: #059669;
  }
</style>
