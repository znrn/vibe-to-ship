---
// 聚合页卡片（阶段 / 形态 / 专题），篇数从内容集合实时统计
import { ROADMAP, PLATFORMS, TOPICS } from '../data/site';
import type { Article } from '../lib/articles';

interface Props {
  articles: Article[];
  kind: 'stage' | 'platform' | 'topic';
}
const { articles, kind } = Astro.props;

const items =
  kind === 'stage'
    ? ROADMAP.map((s) => ({ href: `/flow/${s.slug}/`, icon: s.icon, name: `${s.step} · ${s.short}`, desc: s.desc, n: articles.filter((a) => a.data.stage === s.slug).length }))
    : kind === 'platform'
      ? PLATFORMS.map((p) => ({ href: `/platforms/${p.slug}/`, icon: p.icon, name: `${p.name}上线流程`, desc: p.desc, n: articles.filter((a) => a.data.platforms.includes(p.slug)).length }))
      : TOPICS.map((t) => ({ href: `/topics/${t.slug}/`, icon: t.icon, name: t.name, desc: t.desc, n: articles.filter((a) => a.data.topics.includes(t.slug)).length }));
---

<div class:list={['cats', items.length === 5 && 'five']}>
  {
    items.map((c) => (
      <a class="cat" href={c.href}>
        <div class="ic">{c.icon}</div>
        <h3>{c.name}</h3>
        <p>{c.desc}</p>
        <div class:list={['n', c.n === 0 && 'zero']}>{c.n > 0 ? `${c.n} 篇` : '即将更新'}</div>
      </a>
    ))
  }
</div>
