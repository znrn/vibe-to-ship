---
import { categoryOf, ROADMAP } from '../data/site';
import { articleUrl, formatDate, type Article } from '../lib/articles';

interface Props {
  articles: Article[];
  showDesc?: boolean;
}
const { articles, showDesc = false } = Astro.props;
---

<div class="list">
  {
    articles.map((a) => (
      <a class="item" href={articleUrl(a)} data-search={`${a.data.title} ${a.data.description} ${categoryOf(a.data.category).name}`}>
        <h4>{a.data.title}</h4>
        {showDesc && <p class="desc">{a.data.description}</p>}
        <div class="meta">
          <span class="tag">{categoryOf(a.data.category).name}</span>
          <span>第 {a.data.roadmapStep} 步 · {ROADMAP[a.data.roadmapStep - 1].name}</span>
          <span>{formatDate(a.data.date)}</span>
          {a.data.sample && <span class="sample-tag">示例</span>}
        </div>
      </a>
    ))
  }
</div>
