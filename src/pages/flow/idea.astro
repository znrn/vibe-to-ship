import PillarLayout from '../../layouts/PillarLayout.astro';

const toc = [
  {"id": "sec-header-conclusion", "label": "先说结论", "kind": "conclusion"},
  {"id": "sec-step1", "label": "纸上回答 3 问", "num": "01"},
  {"id": "sec-step2", "label": "降维网页文件", "num": "02"},
  {"id": "sec-step3", "label": "刁民反向追问", "num": "03"},
  {"id": "sec-step4", "label": "半小时搓样板间", "num": "04"},
  {"id": "sec-summary", "label": "避坑红线两条", "kind": "warn"},
  {"id": "sec-faq", "label": "常见问题 FAQ", "kind": "faq"},
