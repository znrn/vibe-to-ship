          <!-- 阶段 3 -->
          <div class="pipeline-phase-group" style="margin-bottom: 0;">
            <div class="phase-badge-bar unified">
              <span class="phase-pill uni-green">第 7～9 步</span>
              <div>
                <span class="phase-title-text">收到钱、过审核、维护好</span>
