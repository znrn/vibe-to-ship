                  <div style="font-size: 12.5px; color: #059669; font-weight: 700; display: flex; justify-content: space-between; border-top: 1px dashed #e2e8f0; padding-top: 12px;">
                    <span>看第 0{step.step} 步</span>
                    <span>➔</span>
                  </div>
