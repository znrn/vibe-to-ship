                    </div>
                    <h3 style="font-size: 17px; font-weight: 800; color: #0f172a; margin-bottom: 8px; line-height: 1.35;">
                      {STEP_TITLES_A1[step.slug] || step.name}
                    </h3>
                    <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin-bottom: 14px;">{step.desc}</p>
                    <div style="font-size: 12px; color: #991b1b; background: #fff5f5; border-left: 3px solid #f87171; padding: 8px 12px; border-radius: 0 6px 6px 0; margin-bottom: 14px; line-height: 1.5;">
                      <strong>🚨 典型卡点：</strong>{step.stuck}
