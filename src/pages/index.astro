---
// 首页（2026-11-02 由 v3 提案转正；改版前的首页备份在 backup/2026-11-02-home-before-v3/index.astro）
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IntentTracker from '../components/IntentTracker.astro';
import { SITE, AUDIENCE, CAMP, WHAT_IS, FREE_STEP } from '../data/site';
import { FLOW_STEPS, flowUrl } from '../data/flow';
import { getArticles, articleUrl, formatDate, stageOfArticle } from '../lib/articles';

const articles = await getArticles();
const recentArticles = articles.slice(0, 6);
const canonical = new URL('/', Astro.site);

// 首页结构化数据：告诉搜索引擎和 AI「这个站叫什么、是谁做的」（文章页各自有 Article/HowTo，这里只放站点级的两项）
const orgId = new URL('/#organization', Astro.site).href;
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.name,
      alternateName: SITE.shortName,
      url: canonical.href,
      logo: new URL('/favicon.png', Astro.site).href,
      description: SITE.description,
      founder: { '@type': 'Person', name: SITE.author.name, description: SITE.author.description },
      ...(SITE.github ? { sameAs: [SITE.github] } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      name: SITE.name,
      alternateName: 'Vibe Coding 一人公司',
      url: canonical.href,
      description: SITE.description,
      inLanguage: 'zh-CN',
      publisher: { '@id': orgId },
    },
  ],
};

