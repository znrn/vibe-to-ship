          /* 第 3 版去框极简清单样式 (Borderless List) */
      .borderless-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin: 0;
        padding: 0;
      }
      .borderless-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 14px;
        color: #475569;
        line-height: 1.65;
      }
      .bl-title {
        color: #0f172a;
        font-size: 14.5px;
        font-weight: 750;
        letter-spacing: -0.2px;
      }
      .bl-title.green {
        color: #064e3b;
      }
      .l-cross-pure {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #fee2e2;
        color: #ef4444;
        display: grid;
        place-items: center;
        font-size: 11px;
        font-weight: 900;
        flex-shrink: 0;
        margin-top: 2px;
      }
      .l-check-pure {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #059669;
        color: #ffffff;
        display: grid;
        place-items: center;
        font-size: 11px;
