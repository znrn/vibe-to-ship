        border-radius: 18px;
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .aud-card-a:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.08);
      }
      .aud-card-a.highlight-border {
        border: 1.5px solid #86efac;
        box-shadow: 0 12px 28px -6px rgba(16, 185, 129, 0.12);
      }
      .aud-header-a {
        margin-bottom: 16px;
      }
      .aud-role-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 6px;
        display: inline-block;
        margin-bottom: 8px;
      }
      .aud-role-badge.ops { background: #fef3c7; color: #b45309; }
      .aud-role-badge.founder { background: #dcfce7; color: #047857; }
      .aud-role-badge.pm { background: #eff6ff; color: #1d4ed8; }
      .aud-role-badge.dev { background: #f3e8ff; color: #7e22ce; }
      .aud-title-a {
        font-size: 17.5px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 4px;
