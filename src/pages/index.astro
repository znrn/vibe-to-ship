            </div>
            <div class="pipeline-grid-a">
              {FLOW_STEPS.slice(3, 6).map((step) => (
                <a href={flowUrl(step.slug)} class="pipe-card-a2">
                  <div>
                    <div class="a2-top-bar">
                      <div class="a2-step-indicator">
                        <span class="a2-step-prefix">STEP</span>
                        <span class="a2-step-main uni">0{step.step}</span>
                      </div>
                      <div class="tech-icon-box uni-icon" set:html={STEP_ICONS[step.slug] || ''} />
