      }
          /* 方案 A 样式：立体卡片 + 徽章 + 痛点引用 + 产出标签 (支持 4 列网格) */
      .aud-grid-a {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-top: 10px;
      }
      .aud-card-a {
        background: #ffffff;
