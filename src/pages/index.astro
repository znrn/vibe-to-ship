      }
      .aud-gain-box {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 16px;
        flex: 1;
      }
      .aud-check-icon {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #059669;
        color: #ffffff;
        display: grid;
        place-items: center;
        font-size: 10px;
        font-weight: 900;
        flex-shrink: 0;
        margin-top: 2px;
      }
      .aud-gain-title {
        font-size: 13.5px;
        font-weight: 750;
        color: #065f46;
        display: block;
        margin-bottom: 4px;
