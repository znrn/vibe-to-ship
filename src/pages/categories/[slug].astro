---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { CATEGORIES } from '../../data/site';
import { getArticles } from '../../lib/articles';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
const articles = (await getArticles()).filter((a) => a.data.category === cat.slug);
---

<BaseLayout title={cat.name} description={`${cat.name}：${cat.desc}`}>
  <div class="wrap page-head">
    <nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href="/categories/">文章分类</a><span>/</span><span>{cat.name}</span></nav>
    <h1>{cat.icon} {cat.name}</h1>
    <p>{cat.desc}</p>
  </div>
  <div class="wrap body">
    {
      articles.length > 0 ? (
        <ArticleList articles={articles} showDesc />
      ) : (
        <div class="empty">这一类的文章还在写。先看看 <a class="more" href="/articles/">全部文章 →</a></div>
      )
    }
  </div>
</BaseLayout>

<style>
  .body{padding-bottom:64px;max-width:820px;margin-left:auto;margin-right:auto}
  .page-head{max-width:820px}
  .empty{border:1px dashed var(--line);border-radius:var(--radius);padding:28px;color:var(--muted);text-align:center}
</style>
