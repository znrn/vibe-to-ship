---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
import { getArticles } from '../../lib/articles';

const articles = await getArticles();
---

<BaseLayout title="分类" description="按五步路线（备账号、做出来、放上网、收到钱、过审核）或产品形态（网站、小程序、App、桌面软件）找到你卡住的地方。">
  <div class="wrap page-head">
    <nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>分类</span></nav>
    <h1>分类</h1>
    <p>先找到自己在哪一步，或者要上线的是什么。</p>
  </div>
  <div class="wrap body">
    <h2>按步骤</h2>
    <CategoryGrid articles={articles} kind="stage" />
    <h2>按产品形态</h2>
    <CategoryGrid articles={articles} kind="platform" />
    <h2>专题</h2>
    <CategoryGrid articles={articles} kind="topic" />
  </div>
</BaseLayout>

<style>
  .body{padding-bottom:64px}
  .body h2{font-size:19px;margin:32px 0 12px}
  .body h2:first-child{margin-top:8px}
</style>
