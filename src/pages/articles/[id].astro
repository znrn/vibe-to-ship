---
// 问题页：/articles/<id>/。流程页文章（kind: flow）在 /flow/<步骤>/ 生成，这里跳过。
import ArticleView from '../../components/article/ArticleView.astro';
import { getArticles, type Article } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.filter((a) => a.data.kind !== 'flow').map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
---

<ArticleView article={article} />
