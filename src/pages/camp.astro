---
// 48 小时 AI 独立开发实战营独立落地页
// 访问路径: /camp/
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, CAMP, FREE_STEP } from '../data/site';

const canonical = new URL('/camp/', Astro.site);
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>48 小时 AI 独立开发线下实战营：两天把产品做上线并收到钱 - 冬瓜</title><link rel="canonical" href={canonical} />
  <meta name="description" content="杭州线下小班，6～10 人，两天时间，主讲和助教在旁边陪你把自己的产品做出来、放上网、配好域名和 HTTPS、收到第一笔钱。首期 9800 元，结业后 30 天继续答疑。">
  <meta name="launchpad-group" content="AI 开发培训">
  {SITE.baiduTongji && (
    <script is:inline set:html={`var _hmt = _hmt || [];(function(){var hm=document.createElement("script");hm.src="https://hm.baidu.com/hm.js?${SITE.baiduTongji}";var s=document.getElementsByTagName("script")[0];s.parentNode.insertBefore(hm,s);})();`} />
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-hover: #f1f5f9;
      --card: #ffffff;
      --line: #e2e8f0;
      --line-light: #cbd5e1;
      --ink: #0f172a;
      --muted: #64748b;
      --emerald: #059669;
      --emerald-dark: #047857;
      --emerald-glow: #ecfdf5;
      --accent: #0284c7;
      --amber: #d97706;
      --radius: 16px;
      --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.06), 0 1px 2px -1px rgb(0 0 0 / 0.06);
      --shadow-md: 0 10px 25px -5px rgb(0 0 0 / 0.06), 0 8px 10px -6px rgb(0 0 0 / 0.04);
      --shadow-lg: 0 20px 30px -10px rgb(0 0 0 / 0.08);
      --font-mono: 'JetBrains Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; background: var(--bg); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, 'Plus Jakarta Sans', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; }
    body { min-height: 100vh; overflow-x: hidden; line-height: 1.65; background: var(--bg); color: var(--ink); }
    a { color: inherit; text-decoration: none; }

    /* Top Nav */
    .top-nav {
      position: sticky; top: 0; z-index: 50;
      background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
      padding: 14px 24px;
    }
    .nav-inner {
      max-width: 1160px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between;
    }
    .brand-wrap { display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
    .brand-badge {
      background: linear-gradient(135deg, #059669, #10b981);
      color: #fff; font-size: 13px; font-weight: 800; padding: 4px 10px; border-radius: 6px;
    }
    .brand-title { font-size: 16px; font-weight: 800; color: var(--ink); letter-spacing: -0.2px; }
    .nav-links { display: flex; align-items: center; gap: 20px; }
    .nav-item { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 600; transition: color 0.2s; }
    .nav-item:hover { color: var(--emerald); }
    .nav-btn {
      background: var(--emerald); color: #ffffff; font-size: 13.5px; font-weight: 700;
      padding: 8px 18px; border-radius: 999px; text-decoration: none; transition: all 0.2s;
      box-shadow: 0 2px 10px rgba(5, 150, 105, 0.25);
    }
    .nav-btn:hover { background: var(--emerald-dark); transform: translateY(-1px); }

    /* Container */
    .container { max-width: 1160px; margin: 0 auto; padding: 0 24px; }

    /* Hero */
    .hero {
      padding: 72px 0 60px; text-align: center; position: relative;
    }
    .hero::before {
      content: ''; position: absolute; top: -40px; left: 50%; transform: translateX(-50%);
      width: 700px; height: 380px; background: radial-gradient(circle, rgba(5, 150, 105, 0.08) 0%, rgba(248, 250, 252, 0) 70%);
      pointer-events: none; z-index: 0;
    }
    .hero-content { position: relative; z-index: 1; }
    .hero-pill {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--emerald-glow); border: 1px solid rgba(5, 150, 105, 0.25);
      padding: 6px 16px; border-radius: 999px; font-size: 13px; color: var(--emerald); font-weight: 700; margin-bottom: 24px;
    }
    .hero-h1 {
      font-size: clamp(32px, 4.8vw, 52px); font-weight: 800; line-height: 1.25; letter-spacing: -1px; margin-bottom: 20px; color: var(--ink);
    }
    .hero-h1 span.hl {
      color: var(--emerald);
      background: linear-gradient(135deg, #059669 0%, #10b981 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .hero-desc {
      font-size: clamp(16px, 1.8vw, 18.5px); color: var(--muted); max-width: 820px; margin: 0 auto 36px; line-height: 1.75;
    }
    .hero-cta-box { display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 40px; }
    .btn-camp-primary {
      background: linear-gradient(135deg, #059669, #047857); color: #ffffff; font-size: 16px; font-weight: 800;
      padding: 14px 32px; border-radius: 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
      box-shadow: 0 4px 18px rgba(5, 150, 105, 0.28); transition: all 0.2s;
    }
    .btn-camp-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(5, 150, 105, 0.38); background: #047857; }
    .btn-camp-secondary {
      background: #ffffff; color: var(--ink); font-size: 15.5px; font-weight: 600;
      padding: 14px 26px; border-radius: 12px; text-decoration: none; border: 1px solid var(--line-light);
      display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; box-shadow: var(--shadow-sm);
    }
    .btn-camp-secondary:hover { background: #f8fafc; border-color: #94a3b8; }
    
    .trust-strip {
      display: flex; justify-content: center; align-items: center; gap: 32px; flex-wrap: wrap;
      font-size: 13.5px; color: var(--muted); border-top: 1px solid var(--line);
      max-width: 900px; margin: 0 auto; padding-top: 24px;
    }
    .trust-item { display: flex; align-items: center; gap: 6px; font-weight: 600; }
    .trust-item svg { color: var(--emerald); }

    /* Section Global */
    .sec { padding: 80px 0; border-top: 1px solid var(--line); }
    .sec-alt { background: #ffffff; }
    .sec-tag { font-size: 12px; font-weight: 800; letter-spacing: 1.5px; color: var(--emerald); text-transform: uppercase; margin-bottom: 8px; display: block; }
    .sec-title { font-size: clamp(26px, 3.2vw, 36px); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 12px; color: var(--ink); }
    .sec-desc { font-size: 16px; color: var(--muted); max-width: 680px; margin-bottom: 40px; }
    .text-center { text-align: center; }
    .text-center .sec-desc { margin-left: auto; margin-right: auto; }

    /* Contrast Box: Why Offline */
    .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
    @media (max-width: 768px) { .why-grid { grid-template-columns: 1fr; } }
    .why-card {
      background: #ffffff; border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; box-shadow: var(--shadow-sm);
    }
    .why-card.highlight {
      border-color: rgba(5, 150, 105, 0.4);
      background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
      box-shadow: 0 8px 30px rgba(5, 150, 105, 0.08);
    }
    .why-badge {
      display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; margin-bottom: 16px;
    }
    .why-badge.fail { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }
    .why-badge.win { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .why-h3 { font-size: 19px; font-weight: 800; margin-bottom: 14px; color: var(--ink); }
    .why-list { list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 14.5px; color: #475569; }
    .why-list li { display: flex; align-items: flex-start; gap: 10px; }
    .why-list li strong { color: var(--ink); }
    .why-list .ico-x { color: #dc2626; font-weight: 900; }
    .why-list .ico-v { color: var(--emerald); font-weight: 900; }

    /* Promises Table */
    .promise-card {
      background: #ffffff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin-top: 24px;
      box-shadow: var(--shadow-sm);
    }
    .promise-grid { display: grid; grid-template-columns: 1fr 1fr; }
    @media (max-width: 768px) { .promise-grid { grid-template-columns: 1fr; } }
    .promise-col { padding: 36px; }
    .promise-col:first-child { border-right: 1px solid var(--line); background: #fcfdfd; }
    .p-tier-badge {
      display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; padding: 4px 12px; border-radius: 6px; margin-bottom: 14px;
    }
    .p-tier-badge.base { background: #dcfce7; color: #047857; }
    .p-tier-badge.target { background: #dbeafe; color: #1d4ed8; }
    .promise-h3 { font-size: 21px; font-weight: 800; margin-bottom: 8px; color: var(--ink); }
    .promise-premise { font-size: 13.5px; color: var(--muted); margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
    .promise-items { list-style: none; display: flex; flex-direction: column; gap: 14px; }
    .promise-items li { display: flex; gap: 10px; font-size: 14.5px; color: #475569; line-height: 1.55; }
    .promise-items li strong { color: var(--ink); }
    .check-mark { color: var(--emerald); font-weight: 800; font-size: 16px; flex-shrink: 0; }

    /* Schedule Timeline */
    .timeline { display: flex; flex-direction: column; gap: 20px; margin-top: 32px; }
    .time-card {
      background: #ffffff; border: 1px solid var(--line); border-radius: 14px; padding: 24px 28px;
      display: grid; grid-template-columns: 240px 1fr; gap: 28px; align-items: start; box-shadow: var(--shadow-sm);
    }
    @media (max-width: 860px) { .time-card { grid-template-columns: 1fr; gap: 16px; } }
    .time-header-box { border-right: 1px solid var(--line); padding-right: 20px; }
    @media (max-width: 860px) { .time-header-box { border-right: none; border-bottom: 1px solid var(--line); padding-bottom: 12px; } }
    .time-phase { font-size: 11px; font-weight: 800; color: var(--emerald); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
    .time-day-title { font-size: 18px; font-weight: 800; color: var(--ink); line-height: 1.35; margin-bottom: 8px; }
    .time-badge { display: inline-block; font-size: 12px; color: var(--muted); background: #f1f5f9; padding: 3px 8px; border-radius: 4px; font-family: var(--font-mono); }
    
    .time-tasks { display: flex; flex-direction: column; gap: 16px; }
    .task-row { display: grid; grid-template-columns: 95px 1fr; gap: 16px; font-size: 14px; }
    @media (max-width: 600px) { .task-row { grid-template-columns: 1fr; gap: 4px; } }
    .task-time { font-family: var(--font-mono); font-size: 12.5px; color: var(--emerald); font-weight: 700; padding-top: 2px; }
    .task-body strong { color: var(--ink); font-weight: 700; }
    .task-body p { color: var(--muted); margin-top: 3px; font-size: 13.5px; line-height: 1.55; }

    /* Who Is This For */
    .audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 24px; }
    @media (max-width: 860px) { .audience-grid { grid-template-columns: 1fr; } }
    .aud-card {
      background: #ffffff; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; box-shadow: var(--shadow-sm);
    }
    .aud-ico { font-size: 28px; margin-bottom: 12px; }
    .aud-role { font-size: 17px; font-weight: 800; color: var(--ink); margin-bottom: 8px; }
    .aud-pain { font-size: 13px; color: #b91c1c; line-height: 1.5; margin-bottom: 12px; background: #fef2f2; border-left: 3px solid #f87171; padding: 8px 12px; border-radius: 0 6px 6px 0; }
    .aud-gain { font-size: 13.5px; color: #334155; line-height: 1.55; }

    .not-for-box {
      margin-top: 28px; background: #fff5f5; border: 1px dashed #fca5a5;
      border-radius: 12px; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    }
    .not-for-text { font-size: 14px; color: #7f1d1d; }
    .not-for-text strong { color: #dc2626; }

    /* Instructor */
    .coach-card {
      background: #ffffff; border: 1px solid var(--line); border-radius: var(--radius); padding: 36px;
      display: grid; grid-template-columns: 120px 1fr; gap: 32px; align-items: center; box-shadow: var(--shadow-sm);
    }
    @media (max-width: 640px) { .coach-card { grid-template-columns: 1fr; text-align: center; } }
    .coach-avatar {
      width: 110px; height: 110px; border-radius: 50%; background: linear-gradient(135deg, #059669, #10b981);
      display: flex; align-items: center; justify-content: center; font-size: 42px; font-weight: 900; color: #fff;
      box-shadow: 0 6px 20px rgba(5, 150, 105, 0.25); margin: 0 auto;
    }
    .coach-name { font-size: 22px; font-weight: 800; color: var(--ink); margin-bottom: 4px; }
    .coach-tag { font-size: 13.5px; color: var(--emerald); font-weight: 700; margin-bottom: 12px; }
    .coach-desc { font-size: 14.5px; color: var(--muted); line-height: 1.7; margin-bottom: 16px; }
    .coach-stats { display: flex; gap: 16px; flex-wrap: wrap; }
    @media (max-width: 640px) { .coach-stats { justify-content: center; } }
    .stat-pill { background: #f8fafc; padding: 6px 14px; border-radius: 8px; font-size: 12.5px; border: 1px solid var(--line); color: var(--muted); }
    .stat-pill strong { color: var(--ink); }

    /* FAQ */
    .faq-list { display: flex; flex-direction: column; gap: 14px; margin-top: 24px; max-width: 900px; margin-left: auto; margin-right: auto; }
    .faq-item {
      background: #ffffff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm);
    }
    .faq-item summary {
      padding: 18px 22px; font-size: 16px; font-weight: 700; color: var(--ink); cursor: pointer; list-style: none;
      display: flex; justify-content: space-between; align-items: center;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: '+'; font-size: 20px; color: var(--emerald); font-weight: 800; transition: transform 0.2s; }
    .faq-item[open] summary::after { content: '−'; }
    .faq-ans { padding: 0 22px 20px; font-size: 14.5px; color: var(--muted); line-height: 1.7; border-top: 1px solid var(--line); padding-top: 14px; }
    .faq-ans strong { color: var(--ink); }

    /* Pricing & Booking */
    .price-sec {
      background: linear-gradient(180deg, var(--bg) 0%, #edf2f7 100%);
      padding: 80px 0 100px; text-align: center;
    }
    .price-box {
      background: #ffffff; border: 2px solid rgba(5, 150, 105, 0.4);
      border-radius: 20px; padding: 44px 36px; max-width: 640px; margin: 0 auto; box-shadow: var(--shadow-lg);
      position: relative;
    }
    .price-badge-top {
      position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
      background: linear-gradient(135deg, #059669, #047857); color: #ffffff;
      font-size: 12px; font-weight: 800; padding: 4px 18px; border-radius: 999px; text-transform: uppercase;
      box-shadow: 0 2px 8px rgba(5, 150, 105, 0.3);
    }
    .price-main { font-size: 46px; font-weight: 900; color: var(--ink); font-family: var(--font-mono); margin: 16px 0 6px; }
    .price-sub { font-size: 13.5px; color: var(--muted); margin-bottom: 24px; }
    .price-features {
      list-style: none; text-align: left; display: flex; flex-direction: column; gap: 12px; margin: 24px 0 32px;
      padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
      font-size: 14.5px; color: #475569;
    }
    .price-features li { display: flex; align-items: center; gap: 10px; }
    .price-features li strong { color: var(--ink); }
    .price-original { font-size: 24px; font-weight: 600; color: #94a3b8; margin-right: 6px; }
    .price-qr { display: flex; align-items: center; gap: 22px; text-align: left; background: #f8fafc; border: 1px solid var(--line); border-radius: 14px; padding: 18px 22px; }
    .price-qr img { width: 180px; height: 180px; border-radius: 10px; flex-shrink: 0; background: #fff; }
    .price-qr-text { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: var(--muted); }
    .price-qr-text strong { font-size: 17px; color: var(--ink); }
    .price-qr-text b { color: var(--emerald-dark); }
    @media (max-width: 560px) { .price-qr { flex-direction: column; text-align: center; } .price-qr-text { align-items: center; } }

    /* Footer */
  </style>
</head>
<body>

  <!-- 顶部导航 -->
  <header class="top-nav">
    <div class="nav-inner">
      <a href="/" class="brand-wrap">
        <span class="brand-badge">实战营</span>
        <span class="brand-title">冬瓜 AI 独立开发 · 48小时线下脱产实训</span>
      </a>
      <nav class="nav-links">
        <a href="#why" class="nav-item">为什么线下</a>
        <a href="#promises" class="nav-item">交付承诺</a>
        <a href="#schedule" class="nav-item">48小时课程表</a>
        <a href="#pricing" class="nav-item">开营与费用</a>
        <a href="#faq" class="nav-item">答疑</a>
        <a href="#pricing" class="nav-btn">立即预约席位</a>
      </nav>
    </div>
  </header>

  <!-- 首屏 Hero -->
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-pill">
        <span>⚡ 线下脱产小班实训</span>
        <span>·</span>
        <span>首期限量 6~10 人</span>
        <span>·</span>
        <span>主讲 + 助教现场一对一</span>
      </div>
      <h1 class="hero-h1">
        48 小时脱产实训：<br>
        带你亲手把第一个产品<span class="hl">推上公网并收到钱</span>
      </h1>
      <p class="hero-desc">
        不讲理论，不背语法。两天时间，在现场手把手把你的想法做成一个能用的产品。离开教室时，手机上能打开你自己的网站，带 HTTPS，能收到钱。
      </p>

      <div class="hero-cta-box">
        <a href="#pricing" class="btn-camp-primary">
          <span>预约首期种子席位 (限量 10 人)</span>
          <span>➔</span>
        </a>
        <a href="/flow/" class="btn-camp-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          <span>先看 9 步上线流程（免费）</span>
        </a>
      </div>

      <div class="trust-strip">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>小班制：主讲 + 助教逐个看</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>真实收钱：微信支付 / 聚合免资质收款</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 为什么需要 48 小时线下营？（痛点反差） -->
  <section class="sec sec-alt" id="why">
    <div class="container">
      <div class="text-center">
        <span class="sec-tag">为什么线下</span>
        <h2 class="sec-title">手册全部开源免费，为什么还要开设 48 小时线下营？</h2>
        <p class="sec-desc">
          写代码已经不难，难的是最后一公里。线上自学缺的不是教程，而是卡住的时候有人在旁边看一眼。
        </p>
      </div>

      <div class="why-grid">
        <div class="why-card">
          <span class="why-badge fail">线上独自摸索</span>
          <h3 class="why-h3">耗费数周时间，最终败给莫名其妙的报错</h3>
          <ul class="why-list">
            <li><span class="ico-x">✕</span> <div><strong>SSH 密钥与终端受阻</strong>：权限被拒、格式不对，卡在连接服务器第一步一整天。</div></li>
            <li><span class="ico-x">✕</span> <div><strong>DNS 与反向代理崩溃</strong>：域名解析没生效、Nginx 报错 502 Bad Gateway，不知道找谁问。</div></li>
