---
// 专题页：跨阶段的视角（工具、成本、岗位、排错、作品）
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import HubIntro from '../../components/HubIntro.astro';
import { TOPICS } from '../../data/site';
import { getArticles, hubOf } from '../../lib/articles';

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const articles = (await getArticles()).filter((a) => a.data.topics.includes(topic.slug));
const hub = await hubOf(`topics/${topic.slug}`);
---

<BaseLayout title={topic.name} description={hub?.data.description ?? `${topic.name}：${topic.desc}`} noindex={articles.length === 0}>
  <div class="wrap page-head">
    <nav class="crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href="/flow/">上线流程</a><span>/</span><span>{topic.name}</span></nav>
    <h1>{topic.icon} {topic.name}</h1>
    <p>{topic.desc}</p>
  </div>
  <div class="wrap body">
    <HubIntro id={`topics/${topic.slug}`} />
    {
      articles.length > 0 ? (
        <ArticleList articles={articles} showDesc />
      ) : (
        <div class="empty">这个专题的文章还在写。先看看 <a class="more" href="/articles/">全部文章 →</a></div>
      )
    }
  </div>
</BaseLayout>

<style>
  .body{padding-bottom:64px;max-width:820px;margin-left:auto;margin-right:auto}
  .page-head{max-width:820px}
  .empty{border:1px dashed var(--line);border-radius:var(--radius);padding:28px;color:var(--muted);text-align:center}
</style>
